# Copier ce fichier en .env.local pour le développement, et renseigner les mêmes variables dans Vercel.

# Connexion Google (client OAuth, étape 4 du README)
AUTH_GOOGLE_ID=xxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxxx
# Secret de session : générer avec `openssl rand -base64 32`
AUTH_SECRET=
# Seule cette adresse Gmail peut se connecter
ALLOWED_EMAIL=votre.adresse@gmail.com

# Base de données Google Sheets (étapes 2 et 3 du README)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# Clé privée du compte de service, entre guillemets, avec les \n littéraux
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Développement sans Google : stockage local dans .data/db.json (ignoré en production)
# DEV_LOCAL=1
